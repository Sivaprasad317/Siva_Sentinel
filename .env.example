# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git, so your keys are never committed.
# Never paste keys into the browser or into chat messages.

# Required for AI summaries and answers. Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional. Which Gemini model to use.
#   gemini-4-argon        = most capable (best for explaining and reasoning). Recommended.
#   gemini-3.8-flash      = fast and strong, good balance.
#   gemini-3.5-flash-lite = cheapest and fastest.
# Model names change over time; see https://ai.google.dev/gemini-api/docs/models for the current list.
GEMINI_MODEL=gemini-4-argon

# Optional but recommended: makes NVD CVSS lookups ~10x faster.
# Request one free at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Optional. How many CVEs to look up on NVD per refresh (0-40).
NVD_MAX_LOOKUPS=8

# Optional. Password-protect the app (username "siva"). Leave empty for local-only use.
APP_ACCESS_TOKEN=

# Optional. Set to 1 to turn off the built-in daily scheduler.
SIVA_DISABLE_SCHEDULER=0

# Optional. Where the local data file is stored (default: ./data)
DATA_DIR=

# ---------------- Patch 2 ----------------
# Optional: ScraperAPI key (https://www.scraperapi.com) to read articles from sites that block simple requests.
SCRAPERAPI_KEY=
# How many top articles Siva reads in full per refresh (0-40). More = better summaries, slower refresh.
ARTICLE_READ_LIMIT=15
# Extra sources (1 = on, 0 = off)
ENABLE_HACKER_NEWS=1
ENABLE_RANSOMWARE_LIVE=1
ENABLE_THREAT_INTEL=1
# Scanning: ONLY list things you own or are authorised to test. Comma separated.
SCAN_ALLOWED_DOMAINS=
SCAN_ALLOWED_PATHS=
SCAN_ALLOWED_REPO_HOSTS=github.com,gitlab.com,bitbucket.org
# Trivy (https://trivy.dev). Leave TRIVY_PATH empty if "trivy" is on your PATH.
TRIVY_PATH=
TRIVY_SERVER_URL=

# ---------------- Patch 4 ----------------
# How Siva addresses you ("Yes boss", "I am checking, boss").
SIVA_USER_TITLE=boss
# Let Gemini search Google for current answers (shows Google search suggestions; 1 = on, 0 = off).
ENABLE_WEB_SEARCH=1
# Background summaries from Wikipedia (1 = on, 0 = off).
ENABLE_WIKIPEDIA=1
# Optional: free abuse.ch Auth-Key (https://auth.abuse.ch/) to check IPs, domains, URLs and hashes in ThreatFox.
ABUSECH_AUTH_KEY=
